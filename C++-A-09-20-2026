// Variables, Types, and I/O 
#include <iostream>
#include <string>
using namespace std;
 
int main() {
    // ----- Declaring Variables of different types -----
    int age = 20;                          // whole numbers
    double price = 19.99;                  // Decimal numbers (double precision)
    float weight = 65.5f;                  // Decimal numbers (single precision, note the 'f')
    char grade = 'A';                      // a single character (single qoutes)
    bool isStudent = true;                 // true or false 
    string name = "Maria";                 // text (needs <string> header)
 
    //----- Output using cout -----
    cout << "Name:" << name << endl;
    cout << "Age:" << age << endl;
    cout << "Price:" << price << endl;
    cout << "Weight:" << weight << endl;
    cout << "Grade:" << grade << endl;
    cout << "is student?" << isStudent << endl; // print 1 for true, 0 for false
 
 
    // ----- Getting input using cin -----
    string userCity;
    cout << "\nEnter your city: ";
    cin >> userCity; // reads one word (stops at whitespace)
    cout << "You live in: " << userCity << endl;
 
    //----- Reading a full line (including spaces)-----
    cin.ignore(); // clears leftover newline character from previous cin
    string fullSentence;
    cout << "Enter a sentence about yourself: ";
    getline(cin, fullSentence); // reads the entire line 
    cout << "You said: " << fullSentence << endl;
 
    return 0;   
}
 
 
// Operator and Expressions
#include <iostream>
using namespace std;
 
int main() {
    int a = 10, b = 3;
 
    // ----- Arithmetic operation -----
    cout << "a + b = " << (a + b) << endl;    // addition
    cout << "a - b = " << (a - b) << endl;    // subtraction
    cout << "a * b = " << (a * b) << endl;    // multiplication
    cout << "a / b = " << (a / b) << endl;    // integer division -> 3 (drops decimal!)
    cout << "a % b = " << (a % b) << endl;    // modulus -> remainder = 1
    double x = 10, y = 3
    cout << "x / y = " << (x / y) << endl;    // 3.33333 -> floating point division
 
    // ------ Relational operation (return bool: 1 or 0) ------
    cout << "\na == b: " << (a == b) << endl; 
    cout << "a != b: " << (a != b) << endl;
    cout << "a > b: " << (a > b) << endl;
    cout << "a < b: " << (a < b) << endl;
 
    //---- Logical operation ----- 
    bool p = true, q = false;
    cout << "\np && q: " << (p && q) << endl; // AND -> false
    cout << "p || q: " << (p || q)   << endl; // OR -> true
    cout << "!p: "     << (!p)       << endl; // NOT -> false
    //----- Assignment operation -----
    int score = 50;
    score += 10; // same as score = score + 10 
    cout << "\nscore after += 10: " << score << endl;
    score *= 2; // same as score = score * 2
    cout << "score after *= 2: " << score << endl;
 
    // ----- Increment / decrement -----
    int counter = 5;
    cout << "\ncounter++ (post): " << counter++ << endl; // prints 5, THEN increments
    cout << "counter now: " << counter << endl;   // inncrements THEN prints -> 7
 
    return 0;
}
 
